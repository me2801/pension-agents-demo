{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Chat API",
    "description": "\nChat with AI workflows. Authenticate via `POST /api/v1/auth/token` (or the **Authorize** button),\nthen start a conversation and send messages. Message responses are streamed as server-sent events.\n\nThe same functionality is available to AI clients over MCP at `/mcp` (same bearer token).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in and get an access token",
        "description": "OAuth2 password flow: exchange username and password for a bearer token.",
        "operationId": "login_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_api_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The current user",
        "description": "Who the bearer token belongs to.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/workflows": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "List available workflows",
        "description": "Workflows the user can chat with.",
        "operationId": "list_workflows_api_v1_workflows_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkflowInfo"
                  },
                  "type": "array",
                  "title": "Response List Workflows Api V1 Workflows Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/conversations": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "List my conversations",
        "description": "The user's conversations, most recently active first, optionally for one workflow.",
        "operationId": "list_conversations_api_v1_conversations_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workflow_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Workflow Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Conversation"
                  },
                  "title": "Response List Conversations Api V1 Conversations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Start a conversation",
        "description": "Create an empty conversation with a workflow.",
        "operationId": "start_conversation_api_v1_conversations_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewConversation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}/messages": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Get a conversation's messages",
        "description": "The transcript, oldest first.",
        "operationId": "get_messages_api_v1_conversations__conversation_id__messages_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Message"
                  },
                  "title": "Response Get Messages Api V1 Conversations  Conversation Id  Messages Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send a message (streamed)",
        "description": "Run the workflow on a message and stream its progress as server-sent events.",
        "operationId": "send_message_api_v1_conversations__conversation_id__messages_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A text/event-stream; every `data:` line is one ChatEvent: `started`, any number of `step`, then `done` or `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatEventSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe",
        "description": "Returns ok while the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_login_api_v1_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login_api_v1_auth_token_post"
      },
      "ChatEventDone": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type",
            "default": "done"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "ChatEventDone",
        "description": "Last event of a streamed turn: the stored assistant message."
      },
      "ChatEventError": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type",
            "default": "error"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "ChatEventError",
        "description": "The turn failed; the error is also stored as an assistant message."
      },
      "ChatEventSchema": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatEventStarted"
          },
          {
            "$ref": "#/components/schemas/Step"
          },
          {
            "$ref": "#/components/schemas/ChatEventDone"
          },
          {
            "$ref": "#/components/schemas/ChatEventError"
          }
        ],
        "title": "ChatEventSchema",
        "description": "One server-sent event of a chat turn (documents the stream in the OpenAPI spec).",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "done": "#/components/schemas/ChatEventDone",
            "error": "#/components/schemas/ChatEventError",
            "started": "#/components/schemas/ChatEventStarted",
            "step": "#/components/schemas/Step"
          }
        }
      },
      "ChatEventStarted": {
        "properties": {
          "type": {
            "type": "string",
            "const": "started",
            "title": "Type",
            "default": "started"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "ChatEventStarted",
        "description": "First event of a streamed turn: the stored user message."
      },
      "Conversation": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "workflow_id": {
            "type": "string",
            "title": "Workflow Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "workflow_id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "Conversation",
        "description": "A chat thread with one workflow, owned by one user."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Markdown"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps",
            "description": "Progress steps behind this answer"
          },
          "choices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Choices",
            "description": "Quick replies offered to the user"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "steps",
          "choices",
          "created_at"
        ],
        "title": "Message",
        "description": "One chat message as shown in the UI."
      },
      "NewConversation": {
        "properties": {
          "workflow_id": {
            "type": "string",
            "title": "Workflow Id"
          }
        },
        "type": "object",
        "required": [
          "workflow_id"
        ],
        "title": "NewConversation",
        "description": "Request body to start a conversation."
      },
      "SendMessage": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "SendMessage",
        "description": "Request body to send a message in a conversation."
      },
      "Step": {
        "properties": {
          "type": {
            "type": "string",
            "const": "step",
            "title": "Type",
            "default": "step"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "Step",
        "description": "A progress update while a workflow runs (e.g. 'calling get_forecast')."
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Lifetime in seconds"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "title": "Token",
        "description": "An issued access token (OAuth2 bearer token response)."
      },
      "User": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "User",
        "description": "An authenticated user."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkflowInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "input_hint": {
            "type": "string",
            "title": "Input Hint"
          },
          "examples": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Examples",
            "description": "Button label -> message to send"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "input_hint",
          "examples"
        ],
        "title": "WorkflowInfo",
        "description": "What the UI needs to know to offer a workflow."
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/v1/auth/token"
          }
        }
      }
    }
  }
}
