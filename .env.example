# Copy to .env (never commit .env). Used by docker compose.
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Creates user "demo" with this password at startup (leave empty to skip).
DEMO_PASSWORD=
ANTHROPIC_API_KEY=sk-ant-...
# "fake" runs a scripted model instead of Claude (for e2e tests and demos without a key).
LLM_PROVIDER=anthropic
